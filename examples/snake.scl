// Snake Game
// Controls: WASD (keys 5/7/8/9)
// Demonstrates: incremental XOR drawing, circular-buffer body, draw-collision
//
// The snake lives on a 2x2 pixel grid: the sprite is 2x2 so what you see is
// exactly what collides. The top 6 rows are a HUD (score + separator) that
// the snake wraps around, so the playfield and display never interact.
// The body is a 256-entry ring buffer - byte indices
// wrap around it naturally, each move draws the new head and erases the old
// tail, so a frame costs a handful of instructions no matter how long the
// snake gets (up to 250 segments - about half the board).

sprite dot[2] = { 0xC0, 0xC0 };
sprite bar[1] = { 0xFF };

void main() {
    byte bodyx[256];
    byte bodyy[256];
    byte head;
    byte tail;
    byte len;
    byte dir;        // 0=up, 1=right, 2=down, 3=left
    byte fx;
    byte fy;
    byte score;
    byte nx;
    byte ny;
    byte restart = 1;

    while (1) {
        if (restart == 1) {
            restart = 0;
            clear;
            head = 2; tail = 0; len = 3; dir = 1; score = 0;
            bodyx[0] = 28; bodyy[0] = 16;
            bodyx[1] = 30; bodyy[1] = 16;
            bodyx[2] = 32; bodyy[2] = 16;
            draw(28, 16, 2, dot);
            draw(30, 16, 2, dot);
            draw(32, 16, 2, dot);
            drawnum(score, 0, 0);
            draw(0, 5, 1, bar);  draw(8, 5, 1, bar);
            draw(16, 5, 1, bar); draw(24, 5, 1, bar);
            draw(32, 5, 1, bar); draw(40, 5, 1, bar);
            draw(48, 5, 1, bar); draw(56, 5, 1, bar);

            // Spawn food somewhere that isn't the snake
            fx = rand(31) * 2;
            fy = rand(255) % 13 * 2 + 6;   // playfield rows 6..30
            draw(fx, fy, 2, dot);
            while (collision) {
                draw(fx, fy, 2, dot);    // undo the bad spawn
                fx = rand(31) * 2;
                fy = rand(255) % 13 * 2 + 6;
                draw(fx, fy, 2, dot);
            }
        }

        // Handle input - prevent reversing direction
        if (key(5)) {
            if (dir != 2) { dir = 0; }  // W = up
        } else if (key(7)) {
            if (dir != 1) { dir = 3; }  // A = left
        } else if (key(8)) {
            if (dir != 0) { dir = 2; }  // S = down
        } else if (key(9)) {
            if (dir != 3) { dir = 1; }  // D = right
        }

        nx = bodyx[head];
        ny = bodyy[head];
        switch (dir) {
            case 0: ny -= 2;
            case 1: nx += 2;
            case 2: ny += 2;
            case 3: nx -= 2;
        }
        nx = nx & 63;
        if (ny < 6)  { ny = 30; }   // wrap within the playfield,
        if (ny > 30) { ny = 6; }    // below the score bar

        head = head + 1;   // byte wrap == ring wrap
        bodyx[head] = nx;
        bodyy[head] = ny;

        if (nx == fx && ny == fy) {
            // Ate the food: erase it, grow (skip the tail erase), respawn
            draw(fx, fy, 2, dot);
            drawnum(score, 0, 0);
            score++;
            drawnum(score, 0, 0);
            beep(3);
            if (len < 250) {
                len++;
            } else {
                // At max length: keep moving the tail
                draw(bodyx[tail], bodyy[tail], 2, dot);
                tail = tail + 1;
            }
            fx = rand(31) * 2;
            fy = rand(255) % 13 * 2 + 6;   // playfield rows 6..30
            draw(fx, fy, 2, dot);
            while (collision) {
                draw(fx, fy, 2, dot);
                fx = rand(31) * 2;
                fy = rand(255) % 13 * 2 + 6;
                draw(fx, fy, 2, dot);
            }
        } else {
            draw(bodyx[tail], bodyy[tail], 2, dot);
            tail = tail + 1;   // byte wrap == ring wrap
        }

        // Draw the new head; a collision here means we bit ourselves
        draw(nx, ny, 2, dot);
        if (collision) {
            beep(30);
            wait(1000);
            restart = 1;
        }

        wait(100);
    }
}
