// Pong - Single Player vs Wall
// Controls: W/S (keys 5/8) to move paddle
// Demonstrates: incremental XOR drawing, functions, collision, game loop

sprite paddle[6] = { 0x80, 0x80, 0x80, 0x80, 0x80, 0x80 };
sprite ball[2] = { 0xC0, 0xC0 };

byte clamp(byte val, byte min, byte max) {
    if (val < min) { return min; }
    if (val > max) { return max; }
    return val;
}

void main() {
    byte px = 2;      // Paddle x (fixed)
    byte py = 13;     // Paddle y
    byte oldpy;
    byte bx = 32;     // Ball x
    byte by = 16;     // Ball y
    byte dx = 2;      // Ball velocity x
    byte dy = 1;      // Ball velocity y
    byte score = 0;

    clear;
    draw(px, py, 6, paddle);
    draw(bx, by, 2, ball);
    drawnum(score, 44, 0);

    while (1) {
        oldpy = py;
        if (key(5)) { py -= 2; }  // W = up
        if (key(8)) { py += 2; }  // S = down
        py = clamp(py, 0, 26);
        if (py != oldpy) {
            draw(px, oldpy, 6, paddle);
            draw(px, py, 6, paddle);
        }

        // Ball: erase, move, redraw
        draw(bx, by, 2, ball);
        bx += dx;
        by += dy;

        if (by < 1) {
            by = 1;
            dy = -dy;
        }
        if (by > 29) {
            by = 29;
            dy = -dy;
        }

        if (bx > 60) {
            bx = 60;
            dx = -dx;
            beep(2);
        }

        if (bx < 5) {
            if (by >= py && by < py + 6) {
                bx = 5;
                dx = -dx;
                drawnum(score, 44, 0);
                score++;
                drawnum(score, 44, 0);
                beep(4);
            } else {
                // Missed - reset ball
                bx = 32;
                by = 16;
                dx = 2;
                beep(10);
            }
        }

        draw(bx, by, 2, ball);
        wait(50);
    }
}
