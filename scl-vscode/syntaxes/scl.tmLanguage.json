{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SCL",
  "scopeName": "source.scl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#sprites" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.scl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.scl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.scl",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.scl",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scl",
          "match": "\\b(if|else|while|for|return|break|continue|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.scl",
          "match": "\\b(const|global|asm|enum|entity)\\b"
        },
        {
          "name": "storage.type.scl",
          "match": "\\b(void|byte|sprite)\\b"
        },
        {
          "name": "keyword.preprocessor.scl",
          "match": "#include"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.scl",
          "match": "\\b(byte|void|sprite)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.scl",
          "match": "\\b(draw|clear|wait|key|waitkey|rand|beep|drawnum)\\b"
        },
        {
          "name": "variable.language.scl",
          "match": "\\b(collision|timer)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.scl",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.scl",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.scl"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.scl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.increment-decrement.scl",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.assignment.scl",
          "match": "(\\+=|-=|\\*=|/=|&=|\\|=|\\^=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.scl",
          "match": "(\\+|-|\\*|/)"
        },
        {
          "name": "keyword.operator.bitwise.scl",
          "match": "(&|\\||\\^)"
        },
        {
          "name": "keyword.operator.logical.scl",
          "match": "(&&|\\|\\||!)"
        }
      ]
    },
    "sprites": {
      "patterns": [
        {
          "name": "meta.sprite.scl",
          "match": "\\b(sprite)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\[",
          "captures": {
            "1": {
              "name": "storage.type.scl"
            },
            "2": {
              "name": "variable.other.sprite.scl"
            }
          }
        }
      ]
    }
  }
}
